# Signal Forge local configuration
# Copy to .env for local use. Never commit .env or real secrets.

APP_ENV=development
PORT=5000

# Development may leave SECRET_KEY unset and the app will generate an
# ephemeral key for the current process. Persistent or production deployments
# must set a strong value of at least 32 characters.
# Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional storage root. Leave unset to use the operating-system temp folder.
# DATA_ROOT=/absolute/path/to/signal-forge-data

# Optional FFmpeg executable override. Leave unset to use imageio-ffmpeg.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
